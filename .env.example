# identity-access-service — every variable the service reads (SPEC-PLAT-06 R78). Copy to .env (git-ignored).
# Values below are DEV-ONLY and target the growercare-local-platform network (container hostnames).
# Production: injected from AWS Secrets Manager via External Secrets (never committed).

# --- required (no defaults; the service refuses to start without them)
# JDBC URL of the gc_iam database
DB_URL=jdbc:postgresql://postgres:5432/gc_iam
# runtime role (DML only)
DB_APP_USER=gc_iam_app
# runtime role password (secret)
DB_APP_PASSWORD=dev_iam_app_pw
# Debezium login role granted on the outbox (migrations)
GC_CDC_ROLE=gc_cdc
# expected token issuer (iss claim)
OIDC_ISSUER_URI=http://localhost:8180/realms/growercare
# where signing keys are fetched
OIDC_JWKS_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/certs
# Keycloak clients allowed to call /internal/**
GC_INTERNAL_CLIENTS=case-service,notification-service
# of those, the clients that may read staff/partner contacts (SPEC-IAM-05 D2: emails for notifications)
GC_CONTACT_CLIENTS=notification-service
# of those, the clients that may resolve principals with grants (the services that authorise users)
GC_PRINCIPAL_CLIENTS=case-service

# --- migrations (only where they run: locally, or the pre-deploy Job)
# default false
GC_MIGRATE=true
# schema owner (DDL)
DB_OWNER_USER=gc_iam_owner
# schema owner password (secret)
DB_OWNER_PASSWORD=dev_iam_owner_pw
# default: classpath:db/migration
GC_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/dev-seed
# default false; only with the dev seed (SPEC-PLAT-04 R63)
GC_FLYWAY_OUT_OF_ORDER=true

# --- optional tunables (safe defaults)
SERVER_PORT=8081
DB_POOL_SIZE=20
# default: none
GC_CORS_ALLOWED_ORIGINS=http://localhost:5173
# default false (Swagger UI only locally)
GC_API_DOCS_ENABLED=true
JAVA_TOOL_OPTIONS=-Xmx512m
